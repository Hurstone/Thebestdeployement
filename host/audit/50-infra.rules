## Règles auditd d'infra (installées dans /etc/audit/rules.d/ par scripts/bootstrap-host.sh)
## Les événements portent une clé (-k) : ils sont lisibles dans Loki avec {job="auditd"} |= `key="cron"`
## "-c" : continuer le chargement même si un chemin n'existe pas (ex : cron non installé)
-c

## Tâches planifiées (crontab, cron.d, répertoires périodiques, crontabs utilisateurs)
-w /etc/crontab -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /var/spool/cron/crontabs/ -p wa -k cron

## Persistance via systemd (nouveaux services / timers)
-w /etc/systemd/system/ -p wa -k systemd_units

## SSH : configuration et clés autorisées de root
-w /etc/ssh/sshd_config -p wa -k sshd_config
-w /etc/ssh/sshd_config.d/ -p wa -k sshd_config
-w /root/.ssh/ -p wa -k ssh_keys

## sudo
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers
